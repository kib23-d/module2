# Використовуємо офіційний образ Linux Debian з встановленим Python
FROM python:3.11-slim

# Створюємо робочу папку в контейнері з прізвищем студента
WORKDIR /oliinyk

# Копіюємо всі файли з поточної папки комп'ютера в папку /oliinyk в контейнері
COPY . /oliinyk/

# Запускаємо термінал bash за замовчуванням
CMD ["/bin/bash"]